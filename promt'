==================================================
34. DOCKER COMPOSE
==================================================

Buat compose yang kurang lebih memiliki konsep:

services:

  backend:
    build:
      context: ./backend
    container_name: personal-gallery-backend
    restart: unless-stopped

    environment:
      GALLERY_ROOT: /data/gallery
      PORT: 8080
      MAX_UPLOAD_SIZE: 10GB

    volumes:
      - /home/secreat/Secreat_data:/data/gallery

    ports:
      - "8080:8080"

  frontend:
    build:
      context: ./frontend
    container_name: personal-gallery-frontend
    restart: unless-stopped

    ports:
      - "3000:3000"

    depends_on:
      - backend

Jangan expose filesystem secara langsung ke frontend.

Frontend hanya berkomunikasi dengan backend API.

